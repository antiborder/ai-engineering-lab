{
  "hosting": {
    "public": "frontend/out",
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*"],
    "predeploy": ["pnpm --dir frontend build"],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "localhost",
      "port": 8080
    },
    "hosting": {
      "host": "localhost",
      "port": 5050
    },
    "ui": {
      "enabled": true,
      "host": "localhost",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
